# Copy to .env in the repo root for docker compose variable substitution:
#   cp .env.docker.example .env   (Linux/Mac)
#   copy .env.docker.example .env (Windows)
#
# Then edit the values below before running: docker compose up -d --build

# ── Required: JWT secrets (use long random strings) ────────────────────────────
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret-min-32-chars
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret-min-32-chars

# ── Required: Public URL of the API (as seen from the user's browser) ──────────
# On a real server: http://YOUR_SERVER_IP:3000  or  https://api.yourdomain.com
# Locally:          http://localhost:3000
API_PUBLIC_BASE_URL=http://localhost:3000

# ── CORS: comma-separated browser origins allowed by the API ───────────────────
# Must include the web app URL (port 3001 locally, or your domain in prod)
# Locally:   http://localhost:3001
# On server: http://YOUR_SERVER_IP:3001  or  https://app.yourdomain.com
CORS_ORIGIN=http://localhost:3001

# ── Storage ────────────────────────────────────────────────────────────────────
# true  = mock storage (files stay in-memory, no S3 needed)
# false = real S3/R2; uncomment and fill the S3_* vars on the api service in docker-compose.yml
STORAGE_MOCK=true
# S3_BUCKET=
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=
# S3_PUBLIC_BASE_URL=

# ── WebRTC TURN server (required for calls across different networks) ───────────
# Get free credentials at https://www.metered.ca/tools/openrelay/
# These are baked into the web JS bundle at build time (NEXT_PUBLIC_*)
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=

# ── TURN credentials passed to the API (for server-side ICE config if needed) ──
TURN_SERVER_URL=turn:openrelay.metered.ca:80
TURN_USERNAME=
TURN_CREDENTIAL=

# ── Dev/Staging: fixed OTP (remove / leave blank in production) ───────────────
# OTP_FIXED_CODE=000000

# ── Optional overrides ─────────────────────────────────────────────────────────
# NEXT_PUBLIC_QR_LOGIN_URL_PREFIX=mobile://qr-login?session=
